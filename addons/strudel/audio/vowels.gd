## Буквы с диакритикой — те же форманты под другими именами (как в оригинале).
const ALIASES := {
	"æ": "ae", "ø": "oe", "ɑ": "aa", "å": "aa",
	"ö": "oe", "ü": "ue", "ı": "y",
}


static func get_formant(letter: String) -> Dictionary:
	var key := letter.strip_edges().to_lower()
	if ALIASES.has(key):
		key = String(ALIASES[key])
	return FORMANTS.get(key, {})


static func names() -> Array:
	return FORMANTS.keys() + ALIASES.keys()
